<section class="bg-white" aria-labelledby="homepage-title">
  <div class="dashboard-container grid gap-10 py-6 sm:py-10 lg:grid-cols-2 lg:items-center lg:gap-12 lg:py-12">
    <div class="min-w-0 max-w-2xl">
      <span class="homepage-label">Personal website + newsletter</span>
      <h1 id="homepage-title" class="mt-6 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl xl:text-6xl">
        <% if local_assigns[:title].present? %>
          <%= raw local_assigns[:title] %>
        <% else %>
          A personal website for everybody on the internet
        <% end %>
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-600">
        Publish a site in 5 minutes, no code or design required. Host on your own domain. Add it to your social profiles, email signature, resume, and more.
      </p>
      <div class="mt-9">
        <a href="<%= new_registration_path('account') %>" class="btn btn-primary btn-big">
          Start your free trial
          <%= render "shared/button_loading_arrow" %>
        </a>
      </div>
    </div>
    <% if @featured_account %>
      <%= render "hero_preview", account: @featured_account %>
    <% end %>
  </div>
</section>
