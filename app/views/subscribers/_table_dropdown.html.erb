<div data-controller="dropdown" class="relative">
  <button
    type="button"
    class="flex items-center text-sm rounded-full focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-200"
    id="subscriber-menu-button-<%= subscription.id %>"
    aria-expanded="false" aria-haspopup="true"
    data-action="dropdown#toggle click@window->dropdown#hide"
    role="button"
    data-dropdown-target="button">
    <span class="sr-only">Open subscriber menu</span>
    <%= heroicon "ellipsis-vertical", class: "h-5 w-5 text-gray-700" %>
  </button>

  <div
    data-dropdown-target="menu"
    data-transition-enter-from="opacity-0 scale-95"
    data-transition-enter-to="opacity-100 scale-100"
    data-transition-leave-from="opacity-100 scale-100"
    data-transition-leave-to="opacity-0 scale-95"
    class="absolute right-0 hidden transition duration-200 ease-in-out origin-top-right transform dropdown-menu focus:outline-none"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="subscriber-menu-button-<%= subscription.id %>"
    tabindex="-1">

    <%= link_to "Delete", page_subscriber_path(account, subscription), data: { 'turbo-confirm': "Are you sure you want to delete this subscriber?", 'turbo-method': :delete },  class: 'dropdown-menu-item', role: 'menuitem' %>
  </div>
</div>